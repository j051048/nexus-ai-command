# Nexus AI Command - local development environment
# Copy this file to .env for local development.

# Frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_API_BASE_URL=http://localhost:8000
VITE_BACKEND_URL=http://localhost:8000
VITE_STRIPE_PUBLISHABLE_KEY=

# Early production rollout guardrails.
# Empty VITE_ENABLED_MODULES means "use default safe module set".
# The default profile is defined in src/config/featureFlags.ts.
VITE_LAUNCH_PROFILE=small_company
# Example override: VITE_ENABLED_MODULES=approval,battlecards,crm,documents,knowledge,projects,reports,sales,tender,vmd
VITE_ENABLED_MODULES=
VITE_DISABLED_MODULES=

# Backend
ENV=development
DEBUG=false
PROJECT_NAME=Nexus AI Command

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
JWT_SECRET=

REDIS_URL=redis://localhost:6379/0
LANGGRAPH_CHECKPOINTER=memory
ENCRYPTION_KEY=change-me-32-plus-random-characters
HEALTH_CHECK_TOKEN=change-me-health-token

# The provider must expose deepseek-v4-flash through an OpenAI-compatible API.
OPENAI_API_KEY=sk-your-provider-key
AI_BASE_URL=https://your-openai-compatible-provider.example/v1
AI_DEFAULT_MODEL=deepseek-v4-flash
AI_MINI_MODEL=deepseek-v4-flash
AI_STRONG_MODEL=deepseek-v4-flash
LLM_FORCE_DEFAULT_MODEL=true
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADDITIONAL_ALLOWED_ORIGINS=

# Cost and abuse protection defaults for a 20-50 person company.
RATE_LIMIT_PER_MINUTE=60
TENANT_RATE_LIMIT_PER_MINUTE=1000
TENANT_RATE_LIMIT_PER_HOUR=10000
MAX_CONCURRENT_LLM_PER_TENANT=5
GLOBAL_MAX_CONCURRENT_LLM=40
TOKEN_BUDGET_MAX_PER_SESSION=60000
TOKEN_BUDGET_MAX_PER_HOUR_PER_USER=120000
TOKEN_BUDGET_MAX_COST_PER_SESSION=2.5
TOKEN_BUDGET_MAX_COST_PER_DAY_PER_TENANT=80
TOKEN_BUDGET_MAX_COST_PER_MONTH_PER_TENANT=1500
LLM_MAX_COST_PER_REQUEST=1.2

# Observability
SENTRY_DSN=
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=0.2

# Optional SaaS billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_ENTERPRISE=
