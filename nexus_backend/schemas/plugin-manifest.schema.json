{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nexus-ai.com/schemas/plugin-manifest.json",
  "title": "Nexus Plugin Manifest",
  "description": "JSON Schema for Nexus AI Plugin Manifest (nexus-plugin.json)",
  "type": "object",
  "required": ["id", "name", "version", "description", "author", "category"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^plugin_[a-z0-9_]+$",
      "description": "Unique plugin ID, must start with 'plugin_' and use snake_case"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 50,
      "description": "Display name of the plugin"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (e.g., 1.0.0)"
    },
    "description": {
      "type": "string",
      "maxLength": 200,
      "description": "Short description of the plugin"
    },
    "author": {
      "type": "string",
      "description": "Author or organization name"
    },
    "category": {
      "type": "string",
      "enum": ["erp", "notification", "productivity", "security", "analytics", "integration"],
      "description": "Plugin category for marketplace display"
    },
    "icon": {
      "type": "string",
      "description": "Lucide icon name for display (e.g., 'database', 'bell', 'shield')"
    },
    "extension_points": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["pre_chat", "post_chat", "pre_tool", "post_tool", "custom_tool", "data_export", "on_error"]
      },
      "description": "System extension points this plugin hooks into"
    },
    "config_schema": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "label", "required"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["text", "password", "number", "boolean", "select"],
            "description": "Input field type"
          },
          "label": {
            "type": "string",
            "description": "Display label for the config field"
          },
          "required": {
            "type": "boolean",
            "description": "Whether this field is required for installation"
          },
          "placeholder": {
            "type": "string",
            "description": "Placeholder text for the input field"
          },
          "default": {
            "description": "Default value for the field"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": { "type": "string" },
                "label": { "type": "string" }
              }
            },
            "description": "Options for select-type fields"
          }
        }
      },
      "description": "Configuration fields required by the plugin"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Action identifier"
          },
          "description": {
            "type": "string",
            "description": "What this action does"
          },
          "params_schema": {
            "type": "object",
            "description": "JSON Schema for action parameters"
          }
        }
      },
      "description": "Executable actions provided by this plugin"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["network", "database_read", "database_write", "file_access", "ai_invoke"]
      },
      "description": "Required system permissions"
    },
    "min_nexus_version": {
      "type": "string",
      "description": "Minimum compatible Nexus version"
    }
  }
}
