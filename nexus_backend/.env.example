# Supabase Configuration
# You must set these in your deployment dashboard (Vercel/Zeabur)

# The URL of your Supabase project (e.g. https://xyz.supabase.co)
SUPABASE_URL=

# The Service Role Key (NOT the Anon Key!)
# This key has full admin access to your database. Keep it secret.
# Find it in Supabase Dashboard -> Settings -> API -> service_role key
SUPABASE_SERVICE_KEY=

# Optional: Port for the backend to run on (default 8000)
PORT=8000
