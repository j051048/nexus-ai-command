# =====================================================
# Nexus AI Backend - Environment Configuration
# =====================================================
# Copy this file to .env and fill in your values
# 标记 [必填] 的变量必须配置，其余为可选（有默认值或功能可关闭）

# ============== 基础环境 ==============
ENV=development                    # development | production
DEBUG=false
PORT=8000
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# ============== 数据库 (Supabase) [必填] ==============
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# 直连数据库（连接池，可选，用于高并发场景）
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ============== AI 服务 [必填] ==============
# 主 AI 服务 — 支持任何 OpenAI 兼容 API
OPENAI_API_KEY=sk-your-api-key
AI_BASE_URL=https://api.openai.com/v1       # 或第三方中转: https://api.apiyi.com/v1

# Anthropic Claude API（当 models.yaml 中配置 provider: anthropic 时使用）
# ANTHROPIC_API_KEY=sk-ant-your-api-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# 模型配置
AI_DEFAULT_MODEL=gpt-4o                     # 默认模型（日常对话）
AI_MINI_MODEL=gpt-4o-mini                   # 轻量模型（意图分类/摘要等）
AI_STRONG_MODEL=                            # 强力模型（复杂推理自动升级，如 claude-sonnet-4-20250514）

# 备用 AI 服务（主服务欠费/故障时自动切换）
# AI_FALLBACK_API_KEY=sk-your-fallback-key
# AI_FALLBACK_BASE_URL=https://your-fallback-provider.com/v1

# ============== Redis（缓存/限流/Celery/WebSocket PubSub）==============
# 不配置则使用内存缓存（单实例可用，多实例必须配置）
# REDIS_URL=redis://localhost:6379/0
# REDIS_POOL_SIZE=10

# ============== Celery 任务队列（定时任务/异步处理）==============
# 需要 Redis，不配置则定时任务功能不可用
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_BEAT_LOCK_TTL=60

# ============== 安全 ==============
# JWT_SECRET=your-fallback-jwt-secret       # 备用 JWT 密钥
# ENCRYPTION_KEY=                           # 主加密密钥（敏感数据加密）
# CSRF_SECRET=                              # CSRF 防护密钥
# ALLOW_UNSECURE_AUTH=false                 # ⚠️ 生产环境绝对不要设为 true！

# CSP 内容安全策略
# CSP_POLICY=default-src 'self'
# CSP_NONCE_ENABLED=false

# 可信代理（反向代理层数，影响 IP 获取）
# TRUSTED_PROXY_COUNT=1

# 密钥管理（可选，支持 HashiCorp Vault）
# KEY_PROVIDER=env                          # env | vault
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=your-vault-token

# ============== API 限流 ==============
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
# RATE_LIMIT_PER_USER=120
# RATE_LIMIT_PER_IP=60
# TENANT_RATE_LIMIT_PER_MINUTE=300
# TENANT_RATE_LIMIT_PER_HOUR=5000
# MAX_CONCURRENT_LLM_PER_TENANT=5

# ============== Token 预算 ==============
MAX_TOKENS_PER_REQUEST=100000
MAX_TOKENS_PER_DAY=1000000
MAX_COST_PER_DAY_USD=50.0
MAX_REQUESTS_PER_DAY=1000
# MAX_TOKENS_PER_ORG_DAY=5000000
# MAX_COST_PER_ORG_DAY_USD=200.0
# MAX_TOKENS_PER_MINUTE=50000
# TOKEN_BUDGET_MAX_PER_SESSION=200000
# TOKEN_BUDGET_MAX_PER_HOUR_PER_USER=500000
# TOKEN_BUDGET_MAX_COST_PER_SESSION=5.0
# TOKEN_BUDGET_MAX_COST_PER_DAY_PER_TENANT=100.0

# ============== 文件上传 ==============
MAX_FILE_SIZE_MB=50

# ============== RAG 配置 ==============
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
# RAG_PARENT_CHUNK_SIZE=1800

# ============== Reranker 配置 ==============
# RERANK_ENABLED=true
# RERANK_PROVIDER=api_reranker              # api_reranker | llm
# RERANK_MODEL=bge-reranker-v2-m3
# RERANK_TOP_N=5
# RERANK_MAX_DOCS=8
# RERANK_TIMEOUT=8
# COHERE_API_KEY=                           # Cohere Rerank API Key

# ============== 搜索服务 ==============
# Brave Search（Agent 联网搜索）
# BRAVE_SEARCH_API_KEY=your-brave-search-key

# ============== 招投标数据 (APISpace) ==============
# 购买地址: https://www.apispace.com/
# 用于标书审阅、招投标信息搜索功能
APISPACE_BIDDING_TOKEN=

# ============== 可观测性 ==============
# Sentry 错误追踪
SENTRY_DSN=

# Langfuse LLM 可观测性（追踪 AI 调用链路）
# 注册地址: https://langfuse.com/
# LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_SECRET_KEY=sk-lf-xxx
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_SAMPLE_RATE=1.0

# OpenTelemetry 分布式追踪
# OTEL_ENABLED=false
# OTEL_EXPORTER_ENDPOINT=http://localhost:4317

# 审计日志
AUDIT_LOGGING_ENABLED=true
AUDIT_BUFFER_SIZE=10
DEBUG_EVENTS=false

# ============== 支付（按需配置）==============
# Stripe 国际支付
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_STARTER=price_xxx
# STRIPE_PRICE_PROFESSIONAL=price_xxx
# STRIPE_PRICE_ENTERPRISE=price_xxx
# STRIPE_SUCCESS_URL=https://your-domain.com/payment/success
# STRIPE_CANCEL_URL=https://your-domain.com/payment/cancel

# 微信支付
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_API_KEY=

# 支付宝
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=

# ============== 通知渠道（按需配置）==============
# 企业微信
# WECOM_WEBHOOK_URL=
# WECOM_CORP_ID=
# WECOM_CORP_SECRET=
# WECOM_AGENT_ID=

# 钉钉
# DINGTALK_WEBHOOK_URL=
# DINGTALK_SECRET=
# DINGTALK_APP_KEY=
# DINGTALK_APP_SECRET=
# DINGTALK_AGENT_ID=

# 飞书
# FEISHU_WEBHOOK_URL=
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_ENCRYPT_KEY=

# Web Push（浏览器推送通知）
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ============== WebSocket ==============
# WS_MAX_PER_USER=3
# WS_MAX_GLOBAL=1000
# WS_HEARTBEAT_INTERVAL=30
# WS_REDIS_HEALTH_INTERVAL=60

# ============== 连接池 ==============
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# HTTP_POOL_SIZE=20

# ============== CORS ==============
# 额外允许的前端域名（逗号分隔）
# ADDITIONAL_ALLOWED_ORIGINS=https://your-frontend.com,https://another-domain.com
# CORS_ALLOWED_ORIGINS_REGEX=

# ============== 数据库迁移 ==============
# AUTO_MIGRATE=false                        # 启动时自动运行迁移（谨慎使用）
