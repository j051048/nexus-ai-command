# =====================================================
# Nexus AI Backend - Environment Configuration
# =====================================================
# Copy this file to .env and fill in your values

# ============== Environment ==============
ENV=development  # development | production
DEBUG=false
PORT=8000

# ============== Database (Supabase) ==============
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ============== AI Configuration ==============
OPENAI_API_KEY=sk-your-api-key
AI_BASE_URL=https://api.openai.com/v1

# ============== Redis (Optional - for distributed caching) ==============
# REDIS_URL=redis://localhost:6379/0

# ============== Security ==============
# JWT_SECRET=your-fallback-jwt-secret
# ALLOW_UNSECURE_AUTH=false  # NEVER set to true in production!

# ============== Rate Limiting ==============
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ============== Usage Limits ==============
MAX_TOKENS_PER_REQUEST=100000
MAX_TOKENS_PER_DAY=1000000
MAX_COST_PER_DAY_USD=50.0
MAX_REQUESTS_PER_DAY=1000

# ============== File Upload ==============
MAX_FILE_SIZE_MB=50

# ============== RAG Configuration ==============
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100

# ============== Observability ==============
SENTRY_DSN=
AUDIT_LOGGING_ENABLED=true
AUDIT_BUFFER_SIZE=10
DEBUG_EVENTS=false

# ============== CORS (comma-separated additional origins) ==============
# ADDITIONAL_ALLOWED_ORIGINS=https://your-frontend.com,https://another-domain.com
# Supabase Configuration
# You must set these in your deployment dashboard (Vercel/Zeabur)

# The URL of your Supabase project (e.g. https://xyz.supabase.co)
SUPABASE_URL=

# The Service Role Key (NOT the Anon Key!)
# This key has full admin access to your database. Keep it secret.
# Find it in Supabase Dashboard -> Settings -> API -> service_role key
SUPABASE_SERVICE_KEY=

# Optional: Port for the backend to run on (default 8000)
PORT=8000
