# Nexus AI Command - production template
# Copy to .env.production for deployment platforms, or map these values to secrets.

ENV=production
DEBUG=false
PROJECT_NAME=Nexus AI Command

# Frontend public runtime variables
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_API_BASE_URL=https://api.your-domain.com
VITE_BACKEND_URL=https://api.your-domain.com
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_LAUNCH_PROFILE=small_company
# Leave blank to use the selected launch profile. Add explicit modules only for a customer-specific rollout.
VITE_ENABLED_MODULES=
VITE_DISABLED_MODULES=dev_tools
VITE_ENABLE_DEMO_DATA=false

# Optional customer integrations enabled by first-launch modules.
# Leave blank unless the customer has provided a production gateway.
KINGDEE_BASE_URL=
KINGDEE_API_KEY=
KINGDEE_INVENTORY_PATH=/inventory/{item_id}
KINGDEE_SALARY_SYNC_PATH=/salary/sync

# Backend required secrets
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
JWT_SECRET=
REDIS_URL=redis://:password@redis-host:6379/0
LANGGRAPH_CHECKPOINTER=postgres
ENCRYPTION_KEY=replace-with-32-plus-random-characters
HEALTH_CHECK_TOKEN=replace-with-random-health-token

# AI gateway
OPENAI_API_KEY=sk-your-primary-key
AI_BASE_URL=https://api.openai.com/v1
AI_DEFAULT_MODEL=gpt-4o-mini
AI_MINI_MODEL=gpt-4o-mini
AI_STRONG_MODEL=gpt-4o
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=
BRAVE_SEARCH_API_KEY=

# Network and rate limits
CORS_ORIGINS=https://app.your-domain.com
ADDITIONAL_ALLOWED_ORIGINS=
PLATFORM_SUPER_ADMIN_EMAILS=j051048@gmail.com
RATE_LIMIT_PER_MINUTE=60
TENANT_RATE_LIMIT_PER_MINUTE=1000
TENANT_RATE_LIMIT_PER_HOUR=10000
MAX_CONCURRENT_LLM_PER_TENANT=5
GLOBAL_MAX_CONCURRENT_LLM=40
CELERY_BROKER_URL=redis://:password@redis-host:6379/1
CELERY_RESULT_BACKEND=redis://:password@redis-host:6379/2
CELERY_MONITORED_QUEUES=default,agent_tools,agent_tools_high_risk,webhooks,sensors
CELERY_QUEUE_DEPTH_WARNING=100
CELERY_QUEUE_DEPTH_CRITICAL=1000
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_MEMORY_FALLBACK_MAX=1000
IDEMPOTENCY_MEMORY_FALLBACK_TTL_SECONDS=3600

# Cost circuit breakers for first 20-50 users
TOKEN_BUDGET_MAX_PER_SESSION=60000
TOKEN_BUDGET_MAX_PER_HOUR_PER_USER=120000
TOKEN_BUDGET_MAX_COST_PER_SESSION=2.5
TOKEN_BUDGET_MAX_COST_PER_DAY_PER_TENANT=80
TOKEN_BUDGET_MAX_COST_PER_MONTH_PER_TENANT=1500
LLM_MAX_COST_PER_REQUEST=1.2
TOKEN_BUDGET_MEMORY_FALLBACK_ENABLED=false

# Observability
SENTRY_DSN=
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=0.2

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_ENTERPRISE=

# Integrations, optional for first launch
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WECOM_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
